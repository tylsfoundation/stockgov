# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=congress_trades
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=replace_with_a_local_password
DATABASE_URL=postgresql://postgres_user:replace_with_a_local_password@localhost:5433/congress_trades
DATABASE_URL_DOCKER=postgresql://postgres_user:replace_with_a_local_password@postgres:5432/congress_trades

# Backend API
API_HOST=0.0.0.0
API_PORT=8000

# Frontend
FRONTEND_URL=http://localhost:3000

# External APIs
CONGRESS_API_KEY=your_congress_api_key_here
FEC_API_KEY=your_fec_api_key_here

# Environment
ENV=development
